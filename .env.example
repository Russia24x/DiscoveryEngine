# CryptoSieve — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite path (default). For production, use PostgreSQL:
#   DATABASE_URL=postgresql://user:pass@localhost:5432/cryptosieve
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ─── API Key Encryption ────────────────────────────────────────────────────
# Used to encrypt API keys at rest (AES-256-GCM). Set to a strong random
# 32+ character string in production. Generate with:
#   openssl rand -base64 32
# If not set, a dev fallback key is used (NOT for production).
# ENCRYPTION_KEY=your-strong-random-key-here

# ─── Data Source API Keys (optional) ───────────────────────────────────────
# These can also be set via the Data Sources UI in the app.
# COINGECKO_API_KEY=
# DEFILLAMA_API_KEY=
# BINANCE_API_KEY=
# CMC_API_KEY=            # CoinMarketCap Pro
# MESSARI_API_KEY=
# NANSEN_API_KEY=

# See https://help.github.com/articles/ignoring-files/ for more about files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit secrets / API keys)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# Skills directory
/skills/

# Database (SQLite local artifacts — schema is source of truth in /prisma)
/db/*.db
/db/*.db-journal
/db/*.db-shm
/db/*.db-wal

# Prisma generated client
/node_modules/.prisma

# Uploads (user-provided scratch files)
/upload/

# Sandbox scripts
/.zscripts/

# Screenshots & watchdog artifacts
screenshot-*.png
.watchdog.log
.watchdog.sh
